rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // DreamEntry Validation
    function isValidDream(data) {
      return data.userId == request.auth.uid &&
             data.timestamp is int &&
             data.transcript is string && data.transcript.size() < 10000 &&
             data.title is string && data.title.size() < 200 &&
             data.interpretation is string && data.interpretation.size() < 10000 &&
             data.emotionalTheme is string &&
             data.archetypes is list && data.archetypes.size() <= 10 &&
             data.symbols is list && data.symbols.size() <= 20;
    }

    // ChatMessage Validation
    function isValidMessage(data) {
      return data.role in ['user', 'model'] &&
             data.content is string && data.content.size() < 5000 &&
             data.timestamp is int &&
             data.dreamId is string;
    }

    // Collection: Dreams
    match /dreams/{dreamId} {
      allow get: if isOwner(existing().userId) && isValidId(dreamId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidDream(incoming()) && isValidId(dreamId);
      allow update: if isOwner(existing().userId) && isValidDream(incoming()) && 
                    incoming().userId == existing().userId &&
                    incoming().timestamp == existing().timestamp &&
                    isValidId(dreamId);
      allow delete: if isOwner(existing().userId) && isValidId(dreamId);

      // Subcollection: Messages
      match /messages/{messageId} {
        // We use get() here to check parent ownership. Standard for subcollections.
        function parentIsOwned() {
          return isOwner(get(/databases/$(database)/documents/dreams/$(dreamId)).data.userId);
        }

        allow get, list: if parentIsOwned() && isValidId(messageId);
        allow create: if parentIsOwned() && isValidMessage(incoming()) && isValidId(messageId);
        allow update, delete: if false; // Messages are immutable in this app
      }
    }
  }
}
